# AgriN AI environment template
# Copy this file to backend/.env for local development.
# Never commit real API keys.

GEMINI_API_KEY_PRIMARY=your_primary_gemini_key_here
GEMINI_MODEL_PRIMARY=gemini-2.5-flash

# Optional backup provider
GEMINI_API_KEY_BACKUP=your_backup_gemini_key_here
GEMINI_MODEL_BACKUP=gemini-3.5-flash-lite

# Local development example
CORS_ORIGINS=http://localhost:3000,http://localhost:5000
